{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "minLength": 1,
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "title": "AgentRef",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "agent_ref": {
          "$ref": "#/$defs/AgentRef"
        },
        "budget_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Usd"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Id",
          "type": "string"
        },
        "input": {
          "default": "",
          "title": "Input",
          "type": "string"
        },
        "inputs_from": {
          "items": {
            "type": "string"
          },
          "title": "Inputs From",
          "type": "array"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retry_backoff_seconds": {
          "default": 0.0,
          "maximum": 60,
          "minimum": 0,
          "title": "Retry Backoff Seconds",
          "type": "number"
        },
        "route_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteWhen"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        }
      },
      "required": [
        "id",
        "agent_ref"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "RouteWhen": {
      "additionalProperties": false,
      "properties": {
        "contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contains"
        },
        "equals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equals"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        }
      },
      "title": "RouteWhen",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "max_parallel": {
      "default": 1,
      "maximum": 16,
      "minimum": 1,
      "title": "Max Parallel",
      "type": "integer"
    },
    "plan_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
      "title": "Plan Id",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "strategy": {
      "default": "single",
      "enum": [
        "single",
        "sequential",
        "routing",
        "fan_out"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "version",
    "steps"
  ],
  "title": "OrchestrationPlan",
  "type": "object"
}
