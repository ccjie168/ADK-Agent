{
  "$defs": {
    "OidcBrowserConfig": {
      "additionalProperties": false,
      "description": "Settings for the browser PKCE flow. Secrets stay in the environment.",
      "properties": {
        "authorization_endpoint": {
          "minLength": 1,
          "title": "Authorization Endpoint",
          "type": "string"
        },
        "client_id": {
          "minLength": 1,
          "title": "Client Id",
          "type": "string"
        },
        "client_secret_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret Env"
        },
        "redirect_uri": {
          "minLength": 1,
          "title": "Redirect Uri",
          "type": "string"
        },
        "scopes": {
          "default": [
            "openid",
            "profile",
            "email"
          ],
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "token_endpoint": {
          "minLength": 1,
          "title": "Token Endpoint",
          "type": "string"
        }
      },
      "required": [
        "client_id",
        "authorization_endpoint",
        "token_endpoint",
        "redirect_uri"
      ],
      "title": "OidcBrowserConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithms": {
      "default": [
        "RS256",
        "ES256"
      ],
      "items": {
        "type": "string"
      },
      "title": "Algorithms",
      "type": "array"
    },
    "audience": {
      "minLength": 1,
      "title": "Audience",
      "type": "string"
    },
    "browser": {
      "anyOf": [
        {
          "$ref": "#/$defs/OidcBrowserConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "issuer": {
      "minLength": 1,
      "title": "Issuer",
      "type": "string"
    },
    "jwks_url": {
      "minLength": 1,
      "title": "Jwks Url",
      "type": "string"
    },
    "kind_claim": {
      "default": "kind",
      "minLength": 1,
      "title": "Kind Claim",
      "type": "string"
    },
    "leeway_seconds": {
      "default": 60,
      "minimum": 0,
      "title": "Leeway Seconds",
      "type": "integer"
    },
    "roles_claim": {
      "default": "roles",
      "minLength": 1,
      "title": "Roles Claim",
      "type": "string"
    },
    "tenant_claim": {
      "default": "tenant",
      "minLength": 1,
      "title": "Tenant Claim",
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "audience",
    "jwks_url"
  ],
  "title": "OidcConfig",
  "type": "object"
}
