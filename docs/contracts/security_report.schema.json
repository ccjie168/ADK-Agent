{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adk-agent.local/contracts/security_report.schema.json",
  "title": "Security scan report",
  "description": "CI-produced scan summary shown by GET /api/security (console --security-report PATH).",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "codeql", "dependencies"],
  "properties": {
    "generated_at": {"type": "string", "description": "ISO 8601 timestamp of the scan run"},
    "codeql": {
      "type": "object",
      "additionalProperties": true,
      "properties": {"open": {"type": "integer", "minimum": 0}}
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": true,
      "properties": {"vulnerabilities": {"type": "integer", "minimum": 0}}
    },
    "notes": {"type": "string"}
  }
}
