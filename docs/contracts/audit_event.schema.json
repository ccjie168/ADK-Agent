{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Digest"
        },
        "digest": {
          "minLength": 1,
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "title": "AgentRef",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "kind": {
          "enum": [
            "human",
            "service",
            "agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "subject",
        "kind"
      ],
      "title": "Principal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "agent_ref": {
      "$ref": "#/$defs/AgentRef"
    },
    "approver": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approver"
    },
    "args_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Args Hash"
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "data_classes": {
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ],
        "type": "string"
      },
      "title": "Data Classes",
      "type": "array"
    },
    "egress": {
      "default": "none",
      "enum": [
        "none",
        "third_party"
      ],
      "title": "Egress",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "fallback_count": {
      "default": 0,
      "minimum": 0,
      "title": "Fallback Count",
      "type": "integer"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "model_alias": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Alias"
    },
    "policy_decision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Decision Id"
    },
    "policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version"
    },
    "principal": {
      "$ref": "#/$defs/Principal"
    },
    "rag_filtered": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rag Filtered"
    },
    "rag_returned": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rag Returned"
    },
    "rag_top_k": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rag Top K"
    },
    "result_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Hash"
    },
    "risk_level": {
      "anyOf": [
        {
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Level"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "denied"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "template_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Id"
    },
    "tenant": {
      "minLength": 1,
      "title": "Tenant",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "trace_id",
    "tenant",
    "principal",
    "agent_ref",
    "action",
    "target",
    "status",
    "timestamp"
  ],
  "title": "AuditEvent",
  "type": "object"
}
