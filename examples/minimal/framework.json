{
  "agents": {
    "fs_agent": {
      "name": "fs_agent",
      "description": "Reads files under the examples directory.",
      "instruction": "Help the user read files. Use the filesystem tools you were given.",
      "model": { "provider": "gemini", "name": "gemini-2.5-pro" },
      "mcp_servers": [
        {
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-filesystem",
            "C:/AI_System/ADK-Agent/examples"
          ],
          "tool_filter": ["read_file", "list_directory"]
        }
      ]
    }
  },
  "expose": "fs_agent",
  "transport": "stdio"
}
