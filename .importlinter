[importlinter]
root_package = adk_agent
include_external_packages = False

[importlinter:contract:core-isolation]
name = core must not import adapters
type = forbidden
source_modules =
    adk_agent.core
forbidden_modules =
    adk_agent.auth
    adk_agent.cli
    adk_agent.config
    adk_agent.console
    adk_agent.factory
    adk_agent.models
    adk_agent.mcp
    adk_agent.registry
    adk_agent.runtime
    adk_agent.templates
